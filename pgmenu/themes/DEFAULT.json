{
  "DEFAULT": {

    "#": "Attributes in Widget for responsive resizing (before methods since they require synthesizing a widget class)",
    "responsive_size": {"type": "variable", "module": "pgmenu", "variable": "PROPORTIONAL"},
    "responsive_size_w": true,
    "responsive_size_h": true,
    "responsive_coords": {"type": "variable", "module": "pgmenu", "variable": "STRETCH"},
    "responsive_coords_x": true,
    "responsive_coords_y": true,

    "#": "Attributes for Button (also viable for other widgets)",
    "coords": [10, 10],
    "size": [100, 30],
    "fill": [42, 120, 205],
    "icon": null,
    "button_text": "Button",
    "#": "font is None since text formats it automatically to VarelaRound",
    "text_font": null,
    "text_color": [255, 255, 255],
    "margin": 3,
    "width": 0,
    "outline_fill": null,
    "on_standby": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_standby"},
    "on_hover": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_hover"},
    "on_press": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_press"},
    "on_release": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_release"},

    "#": "Attributes for aarect (also in RectWidget)",
    "draw_fill": [255, 255, 255],
    "draw_rect": [10, 10, 100, 100],

    "border_radius": 11,
    "border_top_left_radius": {"type": "attribute", "attribute": "border_radius"},
    "border_top_right_radius": {"type": "attribute", "attribute": "border_radius"},
    "border_bottom_left_radius": {"type": "attribute", "attribute": "border_radius"},
    "border_bottom_right_radius": {"type": "attribute", "attribute": "border_radius"},
    "inside_border_radius": {"type": "attribute", "attribute": "border_radius"},
    "inside_border_top_left_radius": {"type": "attribute", "attribute": "inside_border_radius"},
    "inside_border_top_right_radius": {"type": "attribute", "attribute": "inside_border_radius"},
    "inside_border_bottom_left_radius": {"type": "attribute", "attribute": "inside_border_radius"},
    "inside_border_bottom_right_radius": {"type": "attribute", "attribute": "inside_border_radius"},
    "antialiasing": true,
    "inside_antialiasing": {"type": "attribute", "attribute": "antialiasing"},
    "transparency": 255,
    "inside_transparency": {"type": "attribute", "attribute": "transparency"},
    "aa_strength": 1,
    "inside_aa_strength": {"type": "attribute", "attribute": "aa_strength"},
    "inside_fill": null,
    "debug": false,
    "force_only_overlay": false,

    "#": "Attributes for text (also in RectWidget)",
    "text_background": null,
    "text_antialias": true,
    "text_italic": false,
    "text_bold": false,
    "text_strikethrough": false,
    "text_underline": false,
    "text_transparency": 255,
    "widget_text_transparency": {"type": "attribute", "attribute": "transparency"},

    "#": "Attributes for RectWidget",
    "on_key_press": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_key_press"},
    "on_key_release": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_on_key_release"},
    "animation_on_standby": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_standby"},
    "animation_on_hover": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_hover"},
    "animation_on_press": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_press"},
    "animation_on_release": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_release"},
    "animation_on_key_press": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_key_press"},
    "animation_on_key_release": {"type": "method", "module": "pgmenu.widget", "object": "Widget", "method": "m_animation_on_key_release"},

    "no_animation": false,
    "state": {"type": "variable", "module": "pgmenu", "variable": "NORMAL"},

    "#": "Animation attributes in Button (and others)",
    "animation_scale": 1.2,
    "animation_duration": 0.15,
    "animation_curve": {"type": "function", "module": "pgmenu.animation", "function": "circ"},

    "#": "Attributes for text (some are already in button attrs)",
    "text_text": "Text",
    "text_size": 20,
    "text_cache": true,
    "text_coords": [20, 20],
    "text_margin": 0,
    "text_center_x": false,
    "text_center_y": false,
    "text_fit_rect": [100, 30],

    "#": "Attributes for position",
    "pos_center_x": true,
    "pos_center_y": true,

    "#": "General window attributes",
    "bgcolor": [43, 46, 49]
  }
}